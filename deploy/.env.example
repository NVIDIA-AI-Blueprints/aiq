# AI-Q Blueprint - Environment Configuration
#
# Copy to .env and set your values:
#   cp deploy/.env.example deploy/.env

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
APP_ENV=development
LOG_LEVEL=INFO
AIQ_DEV_ENV=cli

# -----------------------------------------------------------------------------
# Backend configuration
# -----------------------------------------------------------------------------
# Workflow config file used by the backend server in Docker Compose.
# The compose stacks mount `configs/` into the container at `/app/configs`.
#
# Examples:
# - /app/configs/config_web_default_llamaindex.yml
# - /app/configs/config_web_frag.yml
BACKEND_CONFIG=

# -----------------------------------------------------------------------------
# API Keys (required for core functionality)
# -----------------------------------------------------------------------------
NVIDIA_API_KEY=


# Web search (Required)
TAVILY_API_KEY=

# Paper search (Optional)
SERPER_API_KEY=   # to disable, update config in configs/ directory


# -----------------------------------------------------------------------------
# Job store (async jobs)
# SQLite: sqlite+aiosqlite:///./data/jobs.db
# PostgreSQL: postgresql+asyncpg://user:pass@host:5432/aiq_jobs
# -----------------------------------------------------------------------------
# NAT_JOB_STORE_DB_URL=
# NAT_CONFIG_FILE=
# NAT_DASK_SCHEDULER_ADDRESS=
# Reduce Dask log noise (optional)
DASK_DISTRIBUTED__LOGGING__DISTRIBUTED=warning

# -----------------------------------------------------------------------------
# Checkpoint DB (LangGraph state)
# SQLite: ./checkpoints.db  |  PostgreSQL: postgresql://user:pass@host:5432/aiq_checkpoints
# -----------------------------------------------------------------------------
# AIQ_CHECKPOINT_DB=

# -----------------------------------------------------------------------------
# Summary DB (document summaries for agents)
# SQLite: sqlite+aiosqlite:///./summaries.db  |  PostgreSQL: postgresql+psycopg://...
# -----------------------------------------------------------------------------
# AIQ_SUMMARY_DB=

# -----------------------------------------------------------------------------
# Evaluation (optional)
# -----------------------------------------------------------------------------
# JINA_API_KEY=
# WANDB_API_KEY=

# -----------------------------------------------------------------------------
# Frontend File Upload Configuration
# -----------------------------------------------------------------------------
# These settings control file upload validation in the knowledge layer.
# Values should match backend limits for consistent user experience.

# Accepted file extensions (comma-separated, include leading dots).
# Default matches LlamaIndex backend. For Foundational RAG, add .pptx:
#   FILE_UPLOAD_ACCEPTED_TYPES=.pdf,.docx,.pptx,.txt,.md
FILE_UPLOAD_ACCEPTED_TYPES=.pdf,.docx,.txt,.md

# Maximum total file size in MB
FILE_UPLOAD_MAX_SIZE_MB=100

# Maximum number of files per session
FILE_UPLOAD_MAX_FILE_COUNT=10

# Hours after upload before files may expire on the backend (0 = no expiry shown),
#this should ideally match TTL of the files on the backend (e.g. 12 hours)
FILE_EXPIRATION_CHECK_INTERVAL_HOURS=0

# -----------------------------------------------------------------------------
# RAG Server and Ingestor URLs (required for knowledge layer)
# -----------------------------------------------------------------------------

# RAG_SERVER_URL=http://localhost:8081/v1
# RAG_INGEST_URL=http://localhost:8082/v1


# -----------------------------------------------------------------------------
# Frontend (UI) runtime configuration (Docker Compose)
# -----------------------------------------------------------------------------
# These variables are consumed by docker-compose.yaml.
# The compose files map them into the UI container as REQUIRE_AUTH and BACKEND_URL.

# Set to true to require OAuth login. False (default) uses a default user.
# REQUIRE_AUTH=false

# Backend URL used by the UI container.
# BACKEND_URL=http://aiq-agent:8000

# -----------------------------------------------------------------------------
# Auth Provider Configuration
# -----------------------------------------------------------------------------
# AUTH_PROVIDER selects which OAuth provider to use:
#   'generic'   (default) - Standard OIDC (Keycloak, Auth0, Okta, Azure AD, etc.)
#   'internalauth'         - Internal OIDC provider

# AUTH_PROVIDER=generic

# Generic OIDC provider env vars (when AUTH_PROVIDER=generic):
# OAUTH_CLIENT_ID=
# OAUTH_CLIENT_SECRET=
# OAUTH_ISSUER=                  # Auto-discovery (recommended)
# OAUTH_AUTH_URL=                # Manual: authorization endpoint
# OAUTH_TOKEN_URL=               # Manual: token endpoint
# OAUTH_USERINFO_URL=            # Manual: userinfo endpoint

# InternalAuth provider env vars (when AUTH_PROVIDER=internalauth):
# INTERNAL_AUTH_CLIENT_ID_BROWSER=
# INTERNAL_AUTH_CLIENT_SECRET=
# INTERNAL_AUTH_ISSUER=                  # Auto-discovery (recommended)
# INTERNAL_AUTH_AUTH_URL=                # Manual: authorization endpoint
# INTERNAL_AUTH_TOKEN_URL=               # Manual: token endpoint
# INTERNAL_AUTH_USERINFO_URL=            # Manual: userinfo endpoint

# NextAuth settings (required when REQUIRE_AUTH=true):
# NEXTAUTH_SECRET=               # Random secret for JWT signing
# NEXTAUTH_URL=http://localhost:3000

# Token refresh buffer in minutes (default: 5, use 30 for long-running ECI jobs)
# TOKEN_REFRESH_BUFFER_MINUTES=5

# idToken cookie lifetime in hours (default: 720 = 30 days, use 24 for enterprise)
# ID_TOKEN_COOKIE_HOURS=720

# Force secure cookies (auto-detected from NEXTAUTH_URL protocol if not set)
# SECURE_COOKIES=true

# -----------------------------------------------------------------------------
# LDAP-API group gating (optional, InternalAuth only)
# -----------------------------------------------------------------------------
# Set all five to enable LDAP group membership checks.
# Omit any one to disable LDAP-API gating (all users allowed).
# INTERNAL_AUTH_SSA_CLIENT_ID=
# INTERNAL_AUTH_SSA_SECRET=
# LDAP_API_SSA_TOKEN_ENDPOINT=
# LDAP_API_GROUPS_ENDPOINT=      # Required; no default endpoint is used
# LDAP_GROUP=
#
# Optional URL template for "Request Access" link on the sign-in page.
# Use {group} placeholder for the group name.
# LDAP_API_GROUP_REQUEST_URL_TEMPLATE=
